{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Compilar .pwn atual (com includes)",
      "type": "shell",
      "command": "cmd.exe",
      "args": [
        "/c",
        "\"C:\\Ferramentas\\qawno\\pawncc.exe\" \"${file}\" -o\"${fileDirname}\\${fileBasenameNoExtension}.amx\" -i\"${workspaceFolder}\\includes\" -; -("
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "options": {
        "cwd": "${fileDirname}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    }
  ]
}
